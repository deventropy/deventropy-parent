<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>org.deventropy.parent</groupId>
	<artifactId>deventropy-parent</artifactId>
	<version>1.0-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>Development Entropy Projects :: Parent POM</name>
	<description>Parent POM for Deventropy, Infix, etc. projects</description>
	<inceptionYear>2015</inceptionYear>
	<url>http://www.deventropy.org/deventropy-parent/</url>
	<organization>
		<name>Development Entropy Projects</name>
		<url>https://www.deventropy.org/</url>
	</organization>
	<prerequisites>
		<maven>3.9</maven>
	</prerequisites>
	<scm>
		<connection>scm:git:https://github.com/deventropy/deventropy-parent.git</connection>
		<developerConnection>scm:git:https://github.com/deventropy/deventropy-parent.git</developerConnection>
		<url>https://github.com/deventropy/deventropy-parent</url>
	</scm>
	<issueManagement>
		<system>GitHub</system>
		<url>https://github.com/deventropy/deventropy-parent/issues</url>
	</issueManagement>
	<licenses>
		<license>
			<name>The Apache Software License, Version 2.0</name>
			<distribution>repo</distribution>
			<url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
		</license>
	</licenses>
	<developers>
		<developer>
			<id>bindul</id>
			<name>Bindul Bhowmik</name>
			<url>http://blog.bindul.name/</url>
			<email>http://goo.gl/J8TIhH</email>
			<roles>
				<role>Project Creator</role>
				<role>Developer</role>
			</roles>
		</developer>
	</developers>
    <!--
	<distributionManagement>
		<snapshotRepository>
			<id>oss-jfrog-artifactory</id>
			<name>oss-jfrog-artifactory-snapshots</name>
			<url>https://oss.jfrog.org/artifactory/oss-snapshot-local</url>
		</snapshotRepository>
	</distributionManagement>
	-->
	<properties>
	   <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
	</properties>
	<build>
	   <pluginManagement>
	       <plugins>
	           <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>3.6.3</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>versions-maven-plugin</artifactId>
                    <version>2.21.0</version>
                </plugin>
	       </plugins>
	   </pluginManagement>
	   <plugins>
	       <plugin>
	           <groupId>org.apache.maven.plugins</groupId>
               <artifactId>maven-enforcer-plugin</artifactId>
               <executions>
                   <execution>
                       <id>enforce-maven-version</id>
                       <goals>
                           <goal>enforce</goal>
                       </goals>
                       <configuration>
                           <rules>
                               <requireMavenVersion>
                                   <version>[3.9,)</version>
                               </requireMavenVersion>
                           </rules>
                       </configuration>
                   </execution>
                </executions>
	       </plugin>
	   </plugins>
	</build>
	<profiles>
		<profile>
			<id>version-check</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>versions-maven-plugin</artifactId>
						<configuration>
                            <ignoredVersions>(?i).*-(alpha|beta|m|rc)([-.]?\d+)?</ignoredVersions>
						</configuration>
						<executions>
							<execution>
								<id>check-version-upgrades</id>
								<phase>validate</phase>
								<goals>
									<goal>display-dependency-updates</goal>
									<goal>display-plugin-updates</goal>
									<goal>display-property-updates</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
	<modules>
		<module>deventropy-cq-config</module>
	</modules>
</project>

